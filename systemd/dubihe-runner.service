[Unit]
Description=Dubihe Runner Service
After=network.target

[Service]
Type=simple
User=dubihe
WorkingDirectory=/opt/dubihe-runner
ExecStart=/opt/dubihe-runner/dubihe daemon
Restart=always
RestartSec=10

# 环境变量
Environment=CONFIG_FILE=/opt/dubihe-runner/config.yaml

# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target